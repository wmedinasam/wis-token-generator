<Window x:Class="GeneradorLlaves.Cadena"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeneradorLlaves"
        mc:Ignorable="d"
        Title="Candea" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="txtIngreso" HorizontalAlignment="Left" Height="100" Margin="10,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="774"/>
        <TextBox x:Name="txtResultado" HorizontalAlignment="Left" Height="224" Margin="10,186,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="774"/>
        <Button x:Name="btnDesencriptar" Content="Desencriptar" HorizontalAlignment="Left" Margin="338,141,0,0" VerticalAlignment="Top" Width="85" Click="btnDesencriptar_Click"/>
        <Button x:Name="btnEncriptar" Content="Encriptar" HorizontalAlignment="Left" Margin="447,141,0,0" VerticalAlignment="Top" Width="85" Click="btnEncriptar_Click"/>

    </Grid>
</Window>
